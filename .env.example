# AI / LLM Keys
GEMINI_API_KEY=
HF_TOKEN=
ELEVENLABS_API_KEY=

# Stock Footage
PEXELS_API_KEY=

# Background Music
SOUNDSTRIPE_API_KEY=

# NVIDIA NIM (Vision-Language Model)
NVIDIA_API_KEY=

# Model Configuration
GEMINI_MODEL=gemini-2.5-flash-preview-05-20
VLM_MODEL=nvidia/nemotron-nano-12b-v2-vl
VLM_BASE_URL=https://integrate.api.nvidia.com
VLM_CONCURRENCY=5
VLM_SEGMENT_SEC=4.0
VLM_SEGMENT_FPS=2.0
VLM_MAX_FRAMES=8
ELEVENLABS_STT_MODEL=scribe_v2

# Media Settings
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=30
OUTPUT_AUDIO_RATE=48000
KEYFRAME_INTERVAL=1

# Server
API_HOST=127.0.0.1
API_PORT=8080

# ── Observability (OpenTelemetry → SigNoz) ─────────────────────────────
# Telemetry is OPT-IN: set KINETOGRAPH_TELEMETRY=1 to export traces + metrics
# via OTLP/HTTP to SigNoz. (Off by default so dev runs aren't spammed with
# connection retries when no collector is running.)
KINETOGRAPH_TELEMETRY=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SigNoz Cloud only — set your ingestion key:
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<YOUR_INGESTION_KEY>
