{
  "name": "kinetograph",
  "version": "0.1.0-alpha.1",
  "description": "AI-powered autonomous video editor",
  "author": "Kinetograph",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:sidecar && npm run build:renderer && electron-builder --publish never",
    "build:sidecar": "node scripts/build-sidecar.cjs",
    "preview": "vite preview",
    "electron:dev": "vite --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:renderer": "tsc && vite build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.1",
    "framer-motion": "^12.34.3",
    "ky": "^1.14.3",
    "lucide-react": "^0.575.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.6.5",
    "tailwind-merge": "^3.5.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "com.kinetograph.app",
    "productName": "Kinetograph",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend",
        "filter": [
          "kinetograph-server*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
